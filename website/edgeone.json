{
  "buildCommand": "npm run build",
  "installCommand": "npm install --ignore-scripts",
  "outputDirectory": "dist",
  "nodeVersion": "22.11.0",
  "cloudFunctions": {
    "nodejs": {
      "maxDuration": 60
    }
  },
  "schedules": [
    {
      "name": "refresh-download-stats",
      "cron": "17 0 * * *",
      "path": "/api/cron/aggregate-downloads",
      "method": "POST",
      "timezone": "UTC"
    }
  ],
  "headers": [
    {
      "source": "/release.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/appcast.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/images/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
